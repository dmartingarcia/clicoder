{
  "title": "CIE-10 SLA & Health",
  "uid": "cie10-sla",
  "tags": ["cie10", "sla", "health"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "60s",
  "time": { "from": "now-24h", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Backend disponibilidad",
      "id": 1,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(probe_success{job=\"blackbox\", service=\"backend\"}[$__range]) * 100", "legendFormat": "", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["mean"] }, "orientation": "horizontal", "text": {} }
    },
    {
      "type": "stat",
      "title": "Frontend disponibilidad",
      "id": 2,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(probe_success{job=\"blackbox\", service=\"frontend\"}[$__range]) * 100", "legendFormat": "", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["mean"] }, "orientation": "horizontal", "text": {} }
    },
    {
      "type": "stat",
      "title": "AI Engine disponibilidad",
      "id": 3,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(probe_success{job=\"blackbox\", service=\"ai_engine\"}[$__range]) * 100", "legendFormat": "", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["mean"] }, "orientation": "horizontal", "text": {} }
    },
    {
      "type": "stat",
      "title": "Backend estado actual",
      "id": 4,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_success{job=\"blackbox\", service=\"backend\"}", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }
    },
    {
      "type": "stat",
      "title": "Frontend estado actual",
      "id": 5,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_success{job=\"blackbox\", service=\"frontend\"}", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }
    },
    {
      "type": "stat",
      "title": "AI Engine estado actual",
      "id": 6,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_success{job=\"blackbox\", service=\"ai_engine\"}", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }
    },
    {
      "type": "timeseries",
      "title": "Disponibilidad (timeline)",
      "id": 7,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_success{job=\"blackbox\", service=\"backend\"}", "legendFormat": "backend", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_success{job=\"blackbox\", service=\"frontend\"}", "legendFormat": "frontend", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_success{job=\"blackbox\", service=\"ai_engine\"}", "legendFormat": "ai_engine", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20 } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Tiempo de respuesta health check",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_duration_seconds{job=\"blackbox\", service=\"backend\"}", "legendFormat": "backend", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_duration_seconds{job=\"blackbox\", service=\"frontend\"}", "legendFormat": "frontend", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_duration_seconds{job=\"blackbox\", service=\"ai_engine\"}", "legendFormat": "ai_engine", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "HTTP status health check",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_http_status_code{job=\"blackbox\", service=\"backend\"}", "legendFormat": "backend", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_http_status_code{job=\"blackbox\", service=\"frontend\"}", "legendFormat": "frontend", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "probe_http_status_code{job=\"blackbox\", service=\"ai_engine\"}", "legendFormat": "ai_engine", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
