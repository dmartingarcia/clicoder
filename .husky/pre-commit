#!/usr/bin/env bash
set -e

STAGED=$(git diff --cached --name-only)

# Frontend: ESLint
if echo "$STAGED" | grep -q "^frontend/"; then
  echo "→ Lint frontend..."
  make frontend-lint
fi

# Backend: format check + credo
if echo "$STAGED" | grep -q "^backend/"; then
  echo "→ Lint backend..."
  make backend-lint
fi

# AI Engine: ruff check + format
if echo "$STAGED" | grep -q "^ai_engine/"; then
  echo "→ Lint ai_engine..."
  make ai-lint
fi
