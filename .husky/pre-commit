#!/usr/bin/env bash
set -e

STAGED=$(git diff --cached --name-only)

# Frontend — ESLint
if echo "$STAGED" | grep -q "^frontend/"; then
  echo "→ Lint frontend..."
  (cd frontend && npm run lint)
fi

# Backend — format check + credo
if echo "$STAGED" | grep -q "^backend/"; then
  echo "→ Lint backend..."
  (cd backend && mix format --check-formatted && mix credo)
fi

# AI Engine — ruff
if echo "$STAGED" | grep -q "^ai_engine/"; then
  echo "→ Lint ai_engine..."
  (cd ai_engine && ruff check .)
fi
