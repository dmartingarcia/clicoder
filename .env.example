# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cie10_app
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:changeme@db:5432/cie10_app
EVENT_STORE_URL=postgresql://postgres:changeme@db:5432/cie10_eventstore

# AI Engine
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://ai_engine:8000
MODEL_NAME=jhu-clsp/mmBERT-base

# Backend (Elixir)
BACKEND_PORT=4000
MIX_ENV=dev
SECRET_KEY_BASE=supersecretkeythatisatleast64byteslongforproductionuse

# Frontend (Next.js)
FRONTEND_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/socket

# Mailpit (fake SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
APP_HOST=localhost

# Jupyter Training
JUPYTER_PORT=8888
JUPYTER_ENABLE_LAB=yes

# Docker User Permissions (obtener con: id -u && id -g)
USER_ID=1000
GROUP_ID=1000

# HuggingFace Token (obtener en: https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx