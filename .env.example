# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cie10_app
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:changeme@db:5432/cie10_app
EVENT_STORE_URL=postgresql://postgres:changeme@db:5432/cie10_eventstore

# AI Engine
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://ai_engine:8000

# Resumidor médico LLM local
SUMMARIZER_MODEL=none             # gemma3 | phi4 | qwen | none
SUMMARIZER_MODE=paraphrase        # summary | paraphrase
# SUMMARIZER_THREADS=4            # hilos CPU para llama-cpp (default: 4)

# Backend (Elixir)
BACKEND_PORT=4000
MIX_ENV=dev
SECRET_KEY_BASE=REPLACE_WITH_OUTPUT_OF__mix_phx.gen.secret__min_64_chars_required
# Local: puertos directos. Producción: https://DOMAIN,https://api.DOMAIN
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Seeds — usuario admin inicial (cambiar en producción)
SEED_ADMIN_EMAIL=myadminuser@clicoder.app
SEED_ADMIN_PASSWORD=password123!

# Frontend (Next.js)
FRONTEND_PORT=3000
NODE_ENV=development
# Local: puertos directos. Producción: https://api.DOMAIN/api y wss://api.DOMAIN/socket
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/socket

# Sentry (error tracking) — obtener DSN en https://sentry.io
SENTRY_DSN=
SENTRY_DSN_AI=
SENTRY_ENVIRONMENT=

# Proxy Traefik — dominio base para el routing
# En local usa localhost; en producción pon tu dominio (ej: miapp.com)
# Rutas: frontend → DOMAIN, backend → api.DOMAIN, grafana → grafana.DOMAIN
DOMAIN=localhost
# Email para los certificados Let's Encrypt - Obligatorio cambiarlo en prod!
TRAEFIK_ACME_EMAIL=acme@example.com
# Hash htpasswd del dashboard. Generar con: make traefik-passwd USER=admin PASSWORD=tupassword
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$changeme$$placeholder

# Grafana
GRAFANA_PASSWORD=changeme

# Mailpit (fake SMTP) - solo dev, ver config/dev.exs
SMTP_HOST=mailpit
SMTP_PORT=1025

# Mailjet - solo prod (Swoosh.Adapters.Mailjet)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=


# Jupyter Training
JUPYTER_PORT=8888
JUPYTER_ENABLE_LAB=yes

# Docker User Permissions (obtener con: id -u && id -g)
USER_ID=1000
GROUP_ID=1000

# HuggingFace Token (obtener en: https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure Translator (back-translation augmentation)
# Free tier F0: 2M chars/mes, sin tarjeta. Obtener en: https://portal.azure.com
AZURE_TRANSLATOR_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_TRANSLATOR_REGION=westeurope
# Lenguas de pivote para back-translation: EN, FR, DE (separadas por espacio)
PIVOT_LANGS=EN